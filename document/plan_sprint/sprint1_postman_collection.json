{
  "info": {
    "name": "Qlda Sprint 1 API Collection",
    "description": "Collection các API chính cho kiểm thử Sprint 1 (Dự án, Gói thầu, Hợp đồng, Tài liệu)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Đăng nhập lấy accessToken",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"admin\",\"password\":\"admin\"}"
        },
        "url": {
          "raw": "http://localhost:8080/auth/login",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["auth", "login"]
        }
      }
    },
    {
      "name": "Lấy thông tin người dùng",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "url": {
          "raw": "http://localhost:8080/auth/users/me",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["auth", "users", "me"]
        }
      }
    },
    {
      "name": "Danh sách dự án",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "url": {
          "raw": "http://localhost:8080/api/projects?page=0&size=10&sort=planYear,desc&status=ACTIVE",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "projects"],
          "query": [
            { "key": "page", "value": "0" },
            { "key": "size", "value": "10" },
            { "key": "sort", "value": "planYear,desc" },
            { "key": "status", "value": "ACTIVE" }
          ]
        }
      }
    },
    {
      "name": "Tạo mới dự án",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Dự án mẫu\",\"planYear\":2025,\"status\":\"ACTIVE\"}"
        },
        "url": {
          "raw": "http://localhost:8080/api/projects",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "projects"]
        }
      }
    },
    {
      "name": "Lấy chi tiết dự án",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "url": {
          "raw": "http://localhost:8080/api/projects/{{projectId}}",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "projects", "{{projectId}}"]
        }
      }
    },
    {
      "name": "Danh sách gói thầu của dự án",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "url": {
          "raw": "http://localhost:8080/api/projects/{{projectId}}/packages",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "projects", "{{projectId}}", "packages"]
        }
      }
    },
    {
      "name": "Tạo mới gói thầu cho dự án",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Gói thầu mẫu\"}"
        },
        "url": {
          "raw": "http://localhost:8080/api/projects/{{projectId}}/packages",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "projects", "{{projectId}}", "packages"]
        }
      }
    },
    {
      "name": "Lấy thông tin hợp đồng của gói thầu",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "url": {
          "raw": "http://localhost:8080/api/packages/{{packageId}}/contract",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "packages", "{{packageId}}", "contract"]
        }
      }
    },
    {
      "name": "Upload tài liệu (multipart)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "projectId", "value": "{{projectId}}", "type": "text" },
            { "key": "files", "type": "file" }
          ]
        },
        "url": {
          "raw": "http://localhost:8080/api/documents/upload",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "documents", "upload"]
        }
      }
    },
    {
      "name": "Download nhiều tài liệu dạng zip",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"ids\":[\"{{docId1}}\",\"{{docId2}}\"]}"
        },
        "url": {
          "raw": "http://localhost:8080/api/documents/download",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "documents", "download"]
        }
      }
    },
    {
      "name": "Danh sách tài liệu theo dự án",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "url": {
          "raw": "http://localhost:8080/api/documents?projectId={{projectId}}",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "documents"],
          "query": [
            { "key": "projectId", "value": "{{projectId}}" }
          ]
        }
      }
    }
  ],
  "variable": [
    { "key": "accessToken", "value": "" },
    { "key": "projectId", "value": "" },
    { "key": "packageId", "value": "" },
    { "key": "docId1", "value": "" },
    { "key": "docId2", "value": "" }
  ]
}

